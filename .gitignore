# Dependencies. No trailing slash on purpose: a worktree borrows the main
# checkout's install as a symlink, which `node_modules/` would not match.
node_modules

# Build outputs
dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Temporary
.tmp/
.cache/
.npmrc
resume.md.devvault.local.json

# Playwright MCP scratch output (snapshots/console logs from browser checks)
.playwright-mcp/

# dev-vault caller key (raw service-tier UUID) — never commit
.devvault.local.json

# Agent worktrees (`git worktree add .claude/worktrees/<task>`). A worktree is
# a FULL second checkout, so without this a `git add -A` commits one whole.
# Scoped deliberately: the REST of .claude/ is tracked (2 files here), and a
# blanket `.claude/` would silently swallow the next command added to it.
.claude/worktrees/
