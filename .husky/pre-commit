#!/bin/sh
# Invoked directly by git (core.hooksPath=.husky), not through husky's generated
# .husky/_ shim — see scripts/install-hooks.mjs for why that shim made worktrees
# skip this hook silently. The two things the shim used to do are here instead:
# the HUSKY=0 escape hatch, and making sure the toolchain is reachable.

# --- worktree preamble ---------------------------------------------------
# git resolves a relative core.hooksPath against the WORKING TREE ROOT, so a
# hook only fires in a linked worktree when the directory holding it is tracked.
# husky's generated .husky/_ is not — its own .gitignore excludes it — so every
# commit made from a worktree ran no hook at all. Silently: no warning, no
# non-zero exit. core.hooksPath now points at .husky itself, which is tracked.
[ "${HUSKY-}" = "0" ] && exit 0

# Not in CI. This hook is the developer loop: it bumps the version, runs
# lint/format/stylelint and typechecks before a LOCAL commit. CI runs every one
# of those as its own job, and publish.yml does not depend on the bump — it
# walks from the registry's latest to the first unpublished version, precisely
# because "CI bumps are published but never committed back, so the committed
# version only falls behind". Nothing here is load-bearing in CI.
#
# It is actively harmful there. The auto-update workflow's "Commit and push if
# changed" step fires this hook, whose gates shell out to pnpm with no
# NODE_AUTH_TOKEN in that step, so the install dies on ERR_PNPM_FETCH_401
# against a private @wolffm package. It hides for months: the step above
# installs WITH the token, so the store is warm and nothing has to be fetched —
# until the one package published minutes earlier, which is exactly what this
# workflow exists to pick up. hadoku-jobplatform hit it on 2026-09-05.
if [ -n "${CI-}" ] || [ -n "${GITHUB_ACTIONS-}" ]; then
  echo "CI detected — skipping pre-commit hook (CI runs these gates as their own jobs)"
  exit 0
fi

# A fresh worktree is missing everything .gitignore excludes, node_modules
# included. Install this worktree's OWN (pnpm hardlinks from its store, so it
# takes seconds when the store is warm). Never link the main checkout's: through
# those links the workspace packages resolve to the MAIN checkout's source, so a
# branch that changes one is typechecked against the old code, and a
# `pnpm install` run in the worktree writes through them into the main checkout.
# Links an older copy of this preamble left behind are removed first.
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in /*) ;; *) common_dir="$PWD/$common_dir" ;; esac
main_checkout=$(dirname "$common_dir")

if [ "$main_checkout" != "$PWD" ]; then
  for nm in $(find . -maxdepth 4 \( -path ./.claude -o -name node_modules -type d \) -prune -o -name node_modules -type l -print); do
    case "$(readlink "$nm")" in
      "$main_checkout"/*) echo "🧹 Removing $nm, a link into the main checkout"; rm "$nm" ;;
    esac
  done
fi
if [ ! -e node_modules ]; then
  echo "📦 No node_modules — installing this checkout's own"
  if ! CI=true pnpm install --frozen-lockfile; then
    echo "❌ pnpm install failed. A private @wolffm package needs NODE_AUTH_TOKEN; install, then commit again."
    exit 1
  fi
fi
# --- end worktree preamble -----------------------------------------------

[ "${HUSKY-}" = "0" ] && exit 0

echo "🔍 Running pre-commit checks..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Auto-fix linting and formatting issues
echo "📋 Running ESLint auto-fix..."
if ! pnpm run lint:fix; then
  echo "❌ ESLint found errors that could not be auto-fixed."
  echo "💡 Please fix the errors manually before committing."
  exit 1
fi

echo "✨ Auto-formatting code..."
pnpm run format

# Re-stage files that were originally staged and potentially modified
echo "📥 Re-staging auto-fixed files..."
echo "${STAGED_FILES}" | xargs -r git add

# CSS gate — fails on `var(--x)` references to undeclared custom properties
# (catches typos against @wolffm/themes)
echo "🎨 Running stylelint..."
if ! pnpm run lint:css; then
  echo "❌ stylelint found unknown CSS custom properties — check the var name against @wolffm/themes."
  exit 1
fi

echo "✅ Linting and formatting complete!"

# Bump version if src/, package.json, or build config changed
echo "📦 Checking if version bump is needed..."

# BUMP=major|minor|patch|none overrides the default. Unset means `auto`: bump the
# patch, rolling over to the next minor at .20. `auto` cannot reach a major, so a
# breaking release needs either BUMP=major or a `feat!:`/`BREAKING CHANGE:` commit
# message, which .husky/post-commit levels up after the fact.
bump_level=$(printf '%s' "${BUMP:-auto}" | tr '[:upper:]' '[:lower:]')
case "$bump_level" in
  major|minor|patch|auto|none) ;;
  *)
    echo "❌ BUMP=$BUMP is not a valid level."
    echo "💡 Use one of: major, minor, patch, none (or leave BUMP unset for auto)."
    exit 1
    ;;
esac

if git diff --cached --name-only | grep -q -E "(src/|package\.json|vite\.config\.|tsconfig\.)"; then
  if [ "$bump_level" = "none" ]; then
    echo "⏭️  BUMP=none — leaving the version alone"
  else
    echo "🔄 Code or build config changes detected, bumping version ($bump_level)..."
    transition=$(node scripts/bump-version.mjs "$bump_level") || exit 1

    if [ -n "$transition" ]; then
      echo "✅ Version bumped: $transition"
      # Dependency edits in this commit can move the lockfile; the root version
      # itself is not recorded there, so this is a no-op for a plain bump.
      pnpm install --lockfile-only
      git add package.json pnpm-lock.yaml
    fi
  fi
else
  echo "ℹ️  No code changes detected, skipping version bump"
fi

echo "✅ All pre-commit checks passed!"

# TS gate — prevents commits that break tsc (resilience plan track 1)
echo "🔎 Running typecheck..."
if ! pnpm run typecheck; then
  echo '❌ TypeScript errors — fix before committing (or --no-verify to bypass).'
  exit 1
fi
